# =====================================================================
# AuraCMS / HMS Monorepo .gitignore
# =====================================================================

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDE & Editor Files ---
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Environment & Secrets ---
.env
.env.*
.env*.local
!.env.example
!**/.env.example
*.pem
*.key
*.cert

# --- Node / Frontend ---
node_modules/
*/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
dist/
*/dist/
build/
*/build/
dist-ssr/
.vite/
*/.vite/
.eslintcache

# --- Python / Backend ---
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
*/venv/
env/
*/env/
ENV/
env.bak/
venv.bak/
.venv/
*/.venv/

# Python Testing & Coverage
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
*/.mypy_cache/
.ruff_cache/

# --- Database & Storage ---
*.sqlite
*.sqlite3
*.db
*.db-journal
postgres_data/
*/postgres_data/

# --- Temporary & Log Files ---
*.log
logs/
*/logs/
tmp/
temp/
*.tmp
